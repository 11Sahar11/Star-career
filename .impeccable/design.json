      "html": "<button class=\"ds-btn-primary\">Continue</button>",
      "css": ":root{--color-bg:#14171c;--color-surface:#1d2229;--color-surface-2:#262c35;--color-line:#303844;--color-fg:#eef1f5;--color-muted:#9aa4b2;--color-accent:#2fb463;--color-accent-2:#6edc97;--color-accent-deep:#23904e;--color-ink:#06160c;--color-trophy:#e5b84a;--color-good:#5cd68f;--color-bad:#f06363;--color-band-high:#5cd68f;--color-band-good:#b5d86b;}.ds-btn-primary{font-family:Rubik,'Segoe UI',system-ui,sans-serif;display:flex;width:100%;height:52px;align-items:center;justify-content:center;border:0;border-radius:6px;background:var(--color-accent);color:var(--color-ink);font-size:1rem;font-weight:600;cursor:pointer;transition:background-color 120ms ease-out;}.ds-btn-primary:hover{background:var(--color-accent-2);}.ds-btn-primary:active{background:var(--color-accent-deep);}.ds-btn-primary:focus-visible{outline:2px solid var(--color-accent-2);outline-offset:2px;}.ds-btn-primary:disabled{opacity:.45;cursor:not-allowed;}"
    },
