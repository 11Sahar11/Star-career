    },
    {
      "name": "Menu List",
      "kind": "nav",
      "refersTo": "list-row",
      "description": "Home menu: 56px hairline-split rows with icon well, label, value or chevron.",
      "html": "<nav class=\"ds-list\"><button class=\"ds-row\"><span class=\"ds-well\" style=\"color:#e5b84a\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9H4.5a2.5 2.5 0 0 1 0-5H6\"/><path d=\"M18 9h1.5a2.5 2.5 0 0 0 0-5H18\"/><path d=\"M4 22h16\"/><path d=\"M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22\"/><path d=\"M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22\"/><path d=\"M18 2H6v7a6 6 0 0 0 12 0V2Z\"/></svg></span><span class=\"ds-t\">Daily race<small>Striker · same start for everyone</small></span><span class=\"ds-v\">2h</span></button><button class=\"ds-row\"><span class=\"ds-well\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9H4.5a2.5 2.5 0 0 1 0-5H6\"/><path d=\"M18 9h1.5a2.5 2.5 0 0 0 0-5H18\"/><path d=\"M4 22h16\"/><path d=\"M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22\"/><path d=\"M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22\"/><path d=\"M18 2H6v7a6 6 0 0 0 12 0V2Z\"/></svg></span><span class=\"ds-t\">Trophies</span><span class=\"ds-v\">3</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"#9aa4b2\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></button></nav>",
      "css": ":root{--color-bg:#14171c;--color-surface:#1d2229;--color-surface-2:#262c35;--color-line:#303844;--color-fg:#eef1f5;--color-muted:#9aa4b2;--color-accent:#2fb463;--color-accent-2:#6edc97;--color-accent-deep:#23904e;--color-ink:#06160c;--color-trophy:#e5b84a;--color-good:#5cd68f;--color-bad:#f06363;--color-band-high:#5cd68f;--color-band-good:#b5d86b;}.ds-list{font-family:Rubik,'Segoe UI',system-ui,sans-serif;display:grid;overflow:hidden;background:var(--color-surface);border:1px solid var(--color-line);border-radius:8px;}.ds-row{font-family:Rubik,'Segoe UI',system-ui,sans-serif;display:flex;width:100%;min-height:56px;align-items:center;gap:12px;padding:9.6px 14.4px;border:0;background:transparent;color:var(--color-fg);text-align:start;font-size:1rem;cursor:pointer;}.ds-row+.ds-row{border-top:1px solid var(--color-line);}.ds-row:hover{background:var(--color-surface-2);}.ds-row:focus-visible{outline:2px solid var(--color-accent-2);outline-offset:-2px;}.ds-well{display:inline-flex;width:32px;height:32px;flex-shrink:0;align-items:center;justify-content:center;border-radius:6px;background:var(--color-surface-2);color:var(--color-muted);}.ds-t{flex:1;font-weight:600;display:grid;}.ds-t small{font-size:.75rem;font-weight:400;color:var(--color-muted);}.ds-v{color:var(--color-muted);font-variant-numeric:tabular-nums;font-size:.75rem;}"
    },
