      "html": "<section class=\"ds-ph\"><div class=\"ds-top\"><div class=\"ds-ovr\">78</div><div><p class=\"ds-nm\">Noa Levi</p><p class=\"ds-sb\">Striker · Haifa Herons</p></div></div><div class=\"ds-st\"><div><span>Ability</span><span class=\"ds-stars\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg></span></div><div><span>Potential</span><span class=\"ds-stars\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path d=\"M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\" fill=\"#e5b84a\"/></svg></span></div></div></section>",
      "css": ":root{--color-bg:#14171c;--color-surface:#1d2229;--color-surface-2:#262c35;--color-line:#303844;--color-fg:#eef1f5;--color-muted:#9aa4b2;--color-accent:#2fb463;--color-accent-2:#6edc97;--color-accent-deep:#23904e;--color-ink:#06160c;--color-trophy:#e5b84a;--color-good:#5cd68f;--color-bad:#f06363;--color-band-high:#5cd68f;--color-band-good:#b5d86b;}.ds-ph{font-family:Rubik,'Segoe UI',system-ui,sans-serif;overflow:hidden;background:var(--color-surface);border:1px solid var(--color-line);border-radius:8px;color:var(--color-fg);}.ds-top{display:flex;gap:12px;align-items:center;padding:14px 16px;}.ds-ovr{display:flex;width:52px;height:52px;align-items:center;justify-content:center;border-radius:6px;background:var(--color-surface-2);color:var(--color-band-good);font-size:1.45rem;font-weight:700;font-variant-numeric:tabular-nums;}.ds-nm{margin:0;font-size:1.125rem;font-weight:700;}.ds-sb{margin:0;font-size:.875rem;color:var(--color-muted);}.ds-st{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--color-line);}.ds-st>div{display:grid;gap:4px;padding:10px 16px;font-size:.75rem;color:var(--color-muted);}.ds-st>div+div{border-inline-start:1px solid var(--color-line);}.ds-stars{display:inline-flex;gap:1px;direction:ltr;}"
    },
    {
      "name": "League Table",
      "kind": "custom",
      "refersTo": "list-row",
      "description": "Fixed-column standings; the player's club row tinted green.",
      "html": "<div class=\"ds-tbl\"><div class=\"ds-tr\"><span>1</span><span>Be'er Sheva Titans</span><span>14</span><span>31</span></div><div class=\"ds-tr ds-me\"><span>2</span><span>Haifa Herons</span><span>14</span><span>29</span></div><div class=\"ds-tr\"><span>3</span><span>Jerusalem Bison</span><span>14</span><span>25</span></div></div>",
      "css": ":root{--color-bg:#14171c;--color-surface:#1d2229;--color-surface-2:#262c35;--color-line:#303844;--color-fg:#eef1f5;--color-muted:#9aa4b2;--color-accent:#2fb463;--color-accent-2:#6edc97;--color-accent-deep:#23904e;--color-ink:#06160c;--color-trophy:#e5b84a;--color-good:#5cd68f;--color-bad:#f06363;--color-band-high:#5cd68f;--color-band-good:#b5d86b;}.ds-tbl{font-family:Rubik,'Segoe UI',system-ui,sans-serif;overflow:hidden;background:var(--color-surface);border:1px solid var(--color-line);border-radius:8px;color:var(--color-fg);}.ds-tr{display:grid;grid-template-columns:1.6rem minmax(0,1fr) 2.4rem 2.2rem;gap:6px;align-items:center;padding:8.8px 14.4px;font-size:.875rem;font-variant-numeric:tabular-nums;}.ds-tr+.ds-tr{border-top:1px solid color-mix(in oklab,var(--color-line) 70%,transparent);}.ds-me{background:color-mix(in oklab,var(--color-accent) 14%,transparent);color:var(--color-accent-2);font-weight:600;}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-option",
      "description": "Tab-like switch; pressed option fills Slate Raised.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Season</button><button aria-pressed=\"false\">Career</button><button aria-pressed=\"false\">Table</button></div>",
      "css": ":root{--color-bg:#14171c;--color-surface:#1d2229;--color-surface-2:#262c35;--color-line:#303844;--color-fg:#eef1f5;--color-muted:#9aa4b2;--color-accent:#2fb463;--color-accent-2:#6edc97;--color-accent-deep:#23904e;--color-ink:#06160c;--color-trophy:#e5b84a;--color-good:#5cd68f;--color-bad:#f06363;--color-band-high:#5cd68f;--color-band-good:#b5d86b;}.ds-seg{display:flex;gap:2px;padding:2px;border-radius:6px;background:var(--color-surface);border:1px solid var(--color-line);}.ds-seg button{font-family:Rubik,'Segoe UI',system-ui,sans-serif;flex:1;min-width:44px;height:44px;border:0;border-radius:4px;background:transparent;color:var(--color-muted);font-size:.875rem;font-weight:600;cursor:pointer;}.ds-seg button:hover{color:var(--color-fg);}.ds-seg button[aria-pressed=true]{background:var(--color-surface-2);color:var(--color-fg);}.ds-seg button:focus-visible{outline:2px solid var(--color-accent-2);outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "The Manager's Clipboard",
    "overview": "STAR is the football-manager standard played straight, at Football Manager Mobile's craft level. The whole career is read off a dark clipboard: a charcoal-slate ground, flat panels split by hairlines, rows of data that can be scanned in a glance on a phone held in one hand. Nothing glows and nothing is gradient-filled; hierarchy comes from tone steps, weight, and a single action colour.\n\nDensity is that of a good sports app: 56px list rows, 14px body text, 12px labels, tabular numerals everywhere a number appears. Every screen resolves into one full-width green Continue (or its equivalent primary action) at the bottom of the flow or in the sticky dock. Hebrew and English are equal citizens: every layout uses logical properties (start/end, inline borders) and directional icons mirror under RTL, while numbers, scores and the wordmark are isolated left-to-right.\n\nThe world explicitly refuses the FIFA / Ultimate Team card-and-glow look and the neon esports look.",
    "keyCharacteristics": [
      "Charcoal-slate ground with three tonal steps and a 1px hairline; no shadows, no gradients.",
      "One action green, reserved for the primary action, the player's own table row, and goal moments.",
      "Attribute and rating numbers coloured by band, FM style (grey, amber, light green, green, teal).",
      "Ability and potential as five gold stars in halves.",
      "Rubik for Hebrew and Latin alike, tabular numerals for all data.",
      "RTL and LTR mirrored through logical properties, numbers always isolated LTR."
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Continue Green is the only action colour. If something is green-filled it is the primary action on that screen, or it is the player themself. One green fill per screen.",
        "section": "colors"
      },
      {
        "name": "The Signal-Only Rule",
        "body": "Gold, good-green, red and the band colours mean something (reward, outcome, rating). They never decorate.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can change — ratings, scores, minutes, money, counts — is set in tabular numerals and isolated left-to-right, so columns align and RTL never reorders digits.",
        "section": "typography"
      },
      {
        "name": "The Weight-Not-Case Rule",
        "body": "Hierarchy is made with weight and size. No uppercase labels, no tracked small caps, no small coloured label stacked above a heading.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Surfaces separate by a 1px hairline and a tone step, never by a shadow, blur or glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** end every screen with one full-width Continue Green primary action (52px), in the sticky dock when the content scrolls.",
      "**Do** separate every surface with a 1px Hairline and a tone step (ground, panel, raised).",
      "**Do** colour attribute values, the overall badge and match ratings by band, and show ability/potential as five gold half-stars.",
      "**Do** set every changing number in tabular numerals, isolated left-to-right.",
      "**Do** use logical properties (start/end, inline borders) and mirror directional icons under RTL so Hebrew and English get identical layouts.",
      "**Do** keep touch targets at 44px minimum."
    ],
    "donts": [
      "**Don't** use gradients, glows, box-shadows or blur; this is not the FIFA card look or a neon esports look.",
      "**Don't** fill anything green that is not the primary action or the player themself.",
      "**Don't** use gold, good-green, red or band colours as decoration.",
      "**Don't** put a small coloured or uppercase label above a heading or title; rank with weight and size.",
      "**Don't** use Dim Slate for readable copy; it is for past or missing values only.",
      "**Don't** use dashed borders except for the league-table gap and the ad slot."
    ]
  }
}